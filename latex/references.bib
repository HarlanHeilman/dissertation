@article{deboerXrayScatteringXray1996a,
	title = {X-ray scattering and x-ray fluorescence from materials with rough interfaces},
	volume = {53},
	rights = {http://link.aps.org/licenses/aps-default-license},
	issn = {0163-1829, 1095-3795},
