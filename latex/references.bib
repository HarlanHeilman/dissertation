@article{pasqualiAnalysisResonantSoft2021,
	title = {Analysis of Resonant Soft X-ray Reflectivity of Anisotropic Layered Materials},
	volume = {4},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2571-9637},
