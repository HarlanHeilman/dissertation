}

@article{itoSpontaneousBuildupGiant2002,
	title = {Spontaneous buildup of giant surface potential by vacuum deposition of Alq3 and its removal by visible light irradiation},
	volume = {92},
	issn = {0021-8979},
	url = {https://doi.org/10.1063/1.1518759},
	doi = {10.1063/1.1518759},
	abstract = {We observed high and persistent spontaneous buildup of the surface potential ({SP}) upon vacuum deposition of tris(8-hydroxyquinolinato) aluminum({III}) (Alq3) on an Au substrate under dark conditions. {SP} determined by the Kelvin probe method reached 28 V at a thickness of 560 nm and the surface of the Alq3 film was positively charged. We propose a model in which preferential orientation of the dipole moments of Alq3 molecules is the origin of this buildup of the {SP}. The intensity of second-harmonic generation was also dramatically increased by the deposition of Alq3 under dark conditions, which supports the notion of a buildup of dipole layers. This giant surface potential was almost completely removed by irradiation of Alq3 molecules with visible light, and irradiation during deposition also prevented the buildup of {SP}.},
	pages = {7306--7310},
	number = {12},
	journaltitle = {Journal of Applied Physics},
	shortjournal = {J. Appl. Phys.},
	author = {Ito, Eisuke and Washizu, Yuuki and Hayashi, Naoki and Ishii, Hisao and Matsuie, Noritaka and Tsuboi, Kazuma and Ouchi, Yukio and Harima, Yutaka and Yamashita, Kazuo and Seki, Kazuhiko},
	urldate = {2026-10-02},
	date = {2002-12-15},
	langid = {english},
}

@article{jacobWallRelaxation$^3He$2001,
	title = {Wall Relaxation of{\textless}mml:math xmlns:mml="http://www.w3.org/1998/Math/{MathML}" display="inline"{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mmultiscripts{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mi{\textgreater}H{\textless}/mml:mi{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mprescripts/{\textgreater}{\textless}mml:mrow/{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mn{\textgreater}3{\textless}/mml:mn{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mrow/{\textgreater}{\textless}mml:mrow/{\textgreater}{\textless}/mml:mmultiscripts{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mi{\textgreater}e{\textless}/mml:mi{\textgreater}{\textless}/mml:math{\textgreater}in Spin-Exchange Cells},
	volume = {87},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.87.143004},
	doi = {10.1103/PhysRevLett.87.143004},
	abstract = {The 3⁢He longitudinal spin-relaxation rate 𝑇−11 is crucial for production of highly polarized 3⁢He by spin-exchange optical pumping. We show that 𝑇−11 is increased by a factor of 2–20 solely by exposure of spin-exchange cells to a few-{kG} magnetic field. The original 𝑇−11 can be restored by degaussing the cell. The effect is attributed to magnetic surface sites and has been observed in both Pyrex and aluminosilicate-glass cells. Our results both advance the understanding of wall relaxation and demonstrate the use of 3⁢He as an extremely sensitive probe of surface magnetism.},
	pages = {143004},
