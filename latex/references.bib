}

@article{shuttleChargeExtractionAnalysis2008,
	title = {Charge extraction analysis of charge carrier densities in a polythiophene/fullerene solar cell: Analysis of the origin of the device dark current},
	volume = {93},
	issn = {0003-6951},
	url = {https://doi.org/10.1063/1.3006316},
