@article{nahlawiHighprecisionDeterminationFrequencyshift2019,
	title = {High-precision determination of the frequency-shift enhancement factor in Rb- {\textless}mml:math xmlns:mml="http://www.w3.org/1998/Math/{MathML}"{\textgreater} {\textless}mml:mmultiscripts{\textgreater} {\textless}mml:mi{\textgreater}Xe{\textless}/mml:mi{\textgreater} {\textless}mml:mprescripts/{\textgreater} {\textless}mml:none/{\textgreater} {\textless}mml:mn{\textgreater}129{\textless}/mml:mn{\textgreater} {\textless}/mml:mmultiscripts{\textgreater} {\textless}/mml:math{\textgreater}},
	volume = {100},
	url = {https://link.aps.org/doi/10.1103/PhysRevA.100.053415},
	doi = {10.1103/PhysRevA.100.053415},
	abstract = {We report a measurement of the dimensionless enhancement factor 𝜅0 for the Rb-129Xe pair commonly used in spin exchange optical pumping ({SEOP}) to produce hyperpolarized 129Xe. 𝜅0 characterizes the amplification of the 129Xe magnetization contribution to the Rb electronic effective field, compared to the case of a uniform continuous medium in classical magnetostatics. The measurement is carried out in Rb vapor cells containing both 3He and 129Xe and relies on the previously measured value of 𝜅0 for the Rb-3He pair. The measurement is based on (1) the optically detected (Faraday rotation) frequency shift of the 87Rb electron paramagnetic resonance ({EPR}) hyperfine spectrum caused by the {SEOP} nuclear polarization and subsequent sudden destruction of nuclear polarization of both species and (2) a comparison of nuclear magnetic resonance signals for the two species acquired just prior to the {EPR} frequency shift measurements. We find (𝜅0){RbXe}=518±8, in good agreement with previous measurements and theoretical estimates but with improved precision.},
	pages = {053415},
	number = {5},
	journaltitle = {Physical Review A},
	shortjournal = {Phys. Rev. A},
	publisher = {American Physical Society},
	author = {Nahlawi, A. I. and Ma, Z. L. and Conradi, M. S. and Saam, B.},
	urldate = {2026-08-10},
	date = {2019-11-22},
	langid = {english},
}

@article{nakanoOriginElectricFielddependent2023,
	title = {Origin of electric field-dependent charge generation in organic photovoltaics with planar and bulk heterojunctions},
	volume = {11},
	issn = {2050-7496},
	url = {https://pubs.rsc.org/en/content/articlelanding/2023/ta/d3ta06835h},
	doi = {10.1039/D3TA06835H},
	abstract = {In organic photovoltaics ({OPVs}), electric field-dependent charge generation often degrades the fill factor and power conversion efficiency, but its origin remains unclear. This work evaluates the electric field dependence for various non-fullerenes, fullerenes, and electron-donating polymers in {OPVs} with bulk heterojunction ({BHJ}) and planar heterojunction ({PHJ}) structures. We found that the electric field dependence in the charge generation process is more obvious in {PHJ} than in {BHJ} structures, even when the same electron donor and acceptor material are used. The insufficient energy difference between singlet excited and charge transfer states primarily causes the electric field-dependent charge generation. In addition, the relative molecular orientation between the donor and acceptor molecules at the interfaces could also be an essential factor determining the charge generation. The results suggest that the end-on orientation of the acceptor molecules to the donor domain is advantageous for efficient field-independent charge generation.},
	pages = {26499--26507},
	number = {48},
	journaltitle = {Journal of Materials Chemistry A},
	shortjournal = {J. Mater. Chem. A},
	publisher = {The Royal Society of Chemistry},
	author = {Nakano, Kyohei and Kaji, Yumiko and Tajima, Keisuke},
	urldate = {2026-01-30},
	date = {2023},
	langid = {english},
}

