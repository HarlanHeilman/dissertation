	urldate = {2026-10-14},
	date = {2012-02},
	langid = {english},
	keywords = {Composition depth profile, Multilayers, Neutron, Phase-sensitive, Reflectivity, Thin films},
}

@article{mondalEffectDepositionTemperature2025,
	title = {Effect of deposition temperature on the quality of Alq3 films and Alq3-Co interfaces},
	volume = {706},
	issn = {0921-4526},
	url = {https://www.sciencedirect.com/science/article/pii/S092145262500242X},
	doi = {10.1016/j.physb.2025.417125},
	abstract = {The quality of organic semiconductor [tris(8-hydroxyquinoline)aluminum] Alq3 films and interface of Alq3-Co heterostructure plays a crucial role in the performance of organic spintronic devices. Four Alq3 thin films were deposited at four different substrate temperatures ranging from 30 °C to 90 °C to study the effects of deposition temperature on its structure using x-ray reflectivity ({XRR}) and Grazing-incidence small-angle x-ray scattering ({GI}-{SAXS}) studies. While {XRR} yields the internal structure of the films, {GISAXS} yields morphology. {XRR} studies reveal good-quality Alq3 films with smooth surfaces roughness less than 10 Å. Electron density gradually increases from 0.40 e/Å3 to 0.43 e/Å3 with increasing deposition temperature, which indicates continual reduction of porosity in the films. {GI}-{SAXS} studies demonstrate that with increasing deposition temperature pore separation increases from 210 Å to 810 Å and pore depth decreases progressively from 300 Å to 150 Å in the Alq3 films. To study Co diffusion into the Alq3 layer, four Si/W/Alq3/Co/Alq3 multilayers were investigated using {XRR} and grazing-incidence x-ray standing wave ({GI}-{XSW}) measurements simultaneously. The Alq3 layers in the multilayers were deposited at the four different substrate temperatures as mentioned above. The combined {XRR} \& {GI}-{XSW} analysis shows that with increasing growth temperature of Alq3 layer, penetration of Co into Alq3 through Co on Alq3 interface gradually reduces from 300 Å to 130 Å with reduced concentration. This study demonstrates that by modulating the deposition temperature of Alq3 film, quality of Alq3 films and interface of Co-Alq3 heterostructures can be improved significantly, which is required for better performance of organic spintronic devices.},
	pages = {417125},
	journaltitle = {Physica B: Condensed Matter},
	shortjournal = {Physica B: Condensed Matter},
	author = {Mondal, Kali Prasanna and Bera, Sambhunath and Gupta, Ajay and Kumar, Dileep and Gupta, Pooja and Gome, Anil and Reddy, V Raghavendra and Pandit, Pallavi and Roth, Stephan V.},
	urldate = {2026-09-29},
	date = {2025-06},
	langid = {english},
	keywords = {Cobalt diffusion into Alq, Combined {XRR} \& {GI}-{XSW}, {GI}-{SAXS}, Organic spintronics, Organic-semiconductor, Si/W/Alq/Co/Alq multilayers},
}

@article{nainCharacterizingNanoscaleOrigins2026,
	title = {Characterizing nanoscale origins of fibrous texture in high moisture extruded texturized pea protein and chicken breast meat using X-ray scattering},
	volume = {49},
	issn = {2213-3291},
	url = {https://www.sciencedirect.com/science/article/pii/S221332912600047X},
	doi = {10.1016/j.foostr.2026.100546},
	abstract = {Consumer awareness about the origin of their food is growing. They are increasingly seeking more sustainable and climate-friendly food options, leading to a shift toward plant-based products. Texturized plant-based proteins, such as high-moisture meat analogs ({HMMA}), using a high-moisture extrusion ({HME}) process, fulfil this. However, there has been limited understanding of {HMMA} structure compared to that of chicken meat. Therefore, this study examines the structural features at the nanometer length scale in extruded {HMMA} made with pea protein, compared with those in chicken meat, using small-angle X-ray scattering ({SAXS}). The {HME} process involved varying the cooling media inlet temperatures from 60 °C to 90 °C in the custom-designed cooling die to assess their impact on the structure of pea protein {HMMA}. The extrudates, once cut and opened, revealed a visually parabolic fibrous structure. {SAXS} analyses revealed that the {HMMA} structure consists of semicrystalline pea protein globulins, which are packed into 30–40 nm rough spheroid-shaped particles. These particles are aggregated into interconnected mass fractal structures that show some nematic ordering, presumably forming the larger parabolic fibrous structure. In contrast, chicken had a larger particle size of ∼200 nm and 5x higher nematic alignment. Moreover, the edges of the extrusion showed more densely packed semicrystalline globulin d-spacing, larger spheroid particles, and increased nematic order compared to the {HMMA} in the middle of the extrusion. Overall, these results point toward nanoscale origins and potential strategies of texturized plant-based proteins that increasingly mimic animal-based proteins.},
	pages = {100546},
	journaltitle = {Food Structure},
	shortjournal = {Food Structure},
	author = {Nain, Sahil and Collins, Brian A. and Ganjyal, Girish M.},
	urldate = {2026-06-30},
	date = {2026-07},
	langid = {english},
	keywords = {Chicken meat, High-moisture extrusion, Meat analogs, Modular cooling die, Small-angle X-ray scattering},
}

@article{yangPotentialdrivenStructuralDistortion2024,
	title = {Potential-driven structural distortion in cobalt phthalocyanine for electrocatalytic {CO}2/{CO} reduction towards methanol},
	volume = {15},
	rights = {2024 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-024-52168-x},
	doi = {10.1038/s41467-024-52168-x},
	abstract = {Cobalt phthalocyanine immobilized on carbon nanotube has demonstrated appreciable selectivity and activity for methanol synthesis in electrocatalytic {CO}2/{CO} reduction. However, discrepancies in methanol production selectivity and activity between {CO}2 and {CO} reduction have been observed, leading to inconclusive mechanisms for methanol production in this system. Here, we discover that the interaction between cobalt phthalocyanine molecules and defects on carbon nanotube substrate plays a key role in methanol production during {CO}2/{CO} electroreduction. Through detailed operando X-ray absorption and infrared spectroscopies, we find that upon application of cathodic potential, this interaction induces the transformation of the planar {CoN}4 center in cobalt phthalocyanine to an out-of-plane distorted configuration. Consequently, this potential induced structural change promotes the transformation of linearly bonded *{CO} at the {CoN}4 center to bridge *{CO}, thereby facilitating methanol production. Overall, these comprehensive mechanistic investigations and the outstanding performance (methanol partial current density over 150 {mA} cm−2) provide valuable insights in guiding the activity and selectivity of immobilized cobalt phthalocyanine for methanol production in {CO}2/{CO} reduction.},
	pages = {7703},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Yang, Haozhou and Guo, Na and Xi, Shibo and Wu, Yao and Yao, Bingqing and He, Qian and Zhang, Chun and Wang, Lei},
	urldate = {2026-03-27},
	date = {2024-09-04},
	langid = {english},
	keywords = {{CO}2 reduction, Electrocatalysis, {XAS}, cobalt phthalocyanine, electrocatalysis, methanol},
}

